[Unit]
Description=Clarity Gemma4 E4B Vision Server (llama.cpp)
After=network.target

[Service]
Type=simple
User=charlie
WorkingDirectory=/home/charlie/Documents/llama.cpp/gguf-output/clarity-e4b-from-unsloth-clean
ExecStart=/home/charlie/Documents/llama.cpp/build/bin/llama-server \
  -m /home/charlie/Documents/llama.cpp/gguf-output/clarity-e4b-from-unsloth-clean/ClarityGuard-v2.gguf \
  --mmproj /home/charlie/Documents/llama.cpp/gguf-output/clarity-e4b-from-unsloth-clean/mmproj-ClarityGuard-v2.gguf \
  --host 0.0.0.0 \
  --port 8081 \
  -c 12288 \
  -ngl 999 \
  --jinja
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
